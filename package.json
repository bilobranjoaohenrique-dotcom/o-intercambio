{
  "name": "o-intercambio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4180",
    "test:browser": "node tests/browser.mjs",
    "test:bedroom": "node tests/bedroom-browser.mjs",
    "test:hallway": "node tests/hallway-browser.mjs",
    "test:living-room": "node tests/living-room-browser.mjs",
    "test:breakfast": "node tests/breakfast-browser.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": { "@babylonjs/core": "^8.0.0" },
  "devDependencies": { "typescript": "~5.9.3", "vite": "^7.1.0", "playwright": "^1.64.1", "pngjs": "^7.0.0" },
  "engines": { "node": ">=24" }
}
