{
  "name": "o-intercambio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4180",
    "test:browser": "node tests/browser.mjs",
    "test:bedroom": "node tests/bedroom-browser.mjs",
    "test:hallway": "node tests/hallway-browser.mjs",
    "test:living-room": "node tests/living-room-browser.mjs",
    "test:breakfast": "node tests/breakfast-browser.mjs",
    "test:garage": "node tests/garage-browser.mjs",
    "test:laundry": "node tests/laundry-browser.mjs",
    "test:parents": "node tests/parents-departure-browser.mjs",
    "test:car-boarding": "node tests/car-direct-browser.mjs",
    "test:airport": "node tests/airport-glb-browser.mjs",
    "test:airport-glb": "node tests/airport-glb-browser.mjs",
    "test:father": "node tests/father-glb-browser.mjs",
    "test:mother": "node tests/mother-glb-browser.mjs",
    "test:car": "node tests/car-direct-browser.mjs",
    "test:mouth": "node tests/speech-mouth-browser.mjs",
    "test:plane": "node tests/plane-glb-browser.mjs",
    "test:arrival": "node tests/arrival-glb-browser.mjs",
    "test:westbridge": "node tests/westbridge-game-browser.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "8.56.2"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
